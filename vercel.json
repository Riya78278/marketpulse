{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "api/**/*.ts": {
      "memory": 512,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard",
      "type": "rewrite"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
