generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String    @map("password_hash")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts  Account[]
  sessions  Session[]
  watchlists Watchlist[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Watchlists ─────────────────────────────────────────

model Watchlist {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  name         String    @default("My Watchlist")
  lastViewedAt DateTime? @map("last_viewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks  WatchlistStock[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistStock {
  id          String   @id @default(cuid())
  watchlistId String   @map("watchlist_id")
  symbol      String
  addedAt     DateTime @default(now()) @map("added_at")
  sortOrder   Int      @default(0) @map("sort_order")

  watchlist          Watchlist                    @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  priceSnapshots    WatchlistStockPriceSnapshot[]

  @@unique([watchlistId, symbol])
  @@index([watchlistId])
  @@map("watchlist_stocks")
}

// ─── Market Data ────────────────────────────────────────

model StockSnapshot {
  id         String   @id @default(cuid())
  symbol     String
  name       String?
  price      Decimal  @db.Decimal(12, 4)
  change     Decimal? @db.Decimal(8, 4)   // daily % change
  changeAbs  Decimal? @db.Decimal(12, 4)  // absolute change
  volume     BigInt?
  avgVolume  BigInt?  @map("avg_volume")
  high52w    Decimal? @db.Decimal(12, 4) @map("high_52w")
  low52w     Decimal? @db.Decimal(12, 4) @map("low_52w")
  marketCap  BigInt?  @map("market_cap")
  pe         Decimal? @db.Decimal(8, 2)
  dayHigh    Decimal? @db.Decimal(12, 4) @map("day_high")
  dayLow     Decimal? @db.Decimal(12, 4) @map("day_low")
  prevClose  Decimal? @db.Decimal(12, 4) @map("prev_close")
  source     String   @default("yahoo")
  status     String   @default("fresh") // fresh | stale | error
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  events MarketEvent[]

  @@unique([symbol, fetchedAt])
  @@index([symbol, fetchedAt(sort: Desc)])
  @@index([symbol])
  @@map("stock_snapshots")
}

// ─── Price Snapshot per Watchlist Stock ───────────────────
// Stores the price of a stock when a user last viewed their watchlist
// This enables accurate "change since last view" calculations

model WatchlistStockPriceSnapshot {
  id             String   @id @default(cuid())
  watchlistStockId String  @map("watchlist_stock_id")
  price          Decimal  @db.Decimal(12, 4)
  change         Decimal? @db.Decimal(8, 4)   // daily % change at that time
  volume         BigInt?
  snapshotAt     DateTime @default(now()) @map("snapshot_at")

  watchlistStock WatchlistStock @relation(fields: [watchlistStockId], references: [id], onDelete: Cascade)

  @@index([watchlistStockId, snapshotAt(sort: Desc)])
  @@map("watchlist_stock_price_snapshots")
}

// ─── Events ─────────────────────────────────────────────

model MarketEvent {
  id            String   @id @default(cuid())
  symbol        String
  eventType     String   @map("event_type")
  // PRICE_MOVE_HIGH, PRICE_MOVE_MEDIUM, VOLUME_SPIKE, NEW_52W_HIGH,
  // NEW_52W_LOW, FUNDAMENTAL_CHANGE
  severity      String   // low | medium | high
  value         String?
  previousValue String?  @map("previous_value")
  description   String   @db.Text
  metadata      Json?
  timestamp     DateTime @default(now())
  source        String   @default("system")

  snapshot   StockSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  snapshotId String?         @map("snapshot_id")

  @@index([symbol, timestamp(sort: Desc)])
  @@index([symbol, severity, timestamp(sort: Desc)])
  @@map("market_events")
}
